root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf

# Windows PowerShell 5.1은 BOM이 없으면 한글을 깨뜨림
[*.ps1]
charset = utf-8-bom
end_of_line = crlf
